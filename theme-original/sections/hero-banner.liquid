<div class="hero-section" style="background: linear-gradient(135deg, rgba(15,23,42,0.95), rgba(30,41,59,0.85)), url('{{ section.settings.image | image_url: width: 1800 }}') center/cover no-repeat; color: #ffffff; padding: 6rem 0;">
  <div class="page-width">
    <div class="hero-section__content">
      {%- if section.settings.badge != blank -%}
        <div style="display:inline-block; padding: 0.35rem 0.85rem; background: rgba(59, 130, 246, 0.2); border: 1px solid rgba(59, 130, 246, 0.5); border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #60a5fa; margin-bottom: 1.25rem;">
          {{ section.settings.badge }}
        </div>
      {%- endif -%}

      <h1 class="hero-section__heading" style="color: #ffffff;">
        {{ section.settings.heading }}
      </h1>

      <p class="hero-section__text" style="color: #cbd5e1;">
        {{ section.settings.text }}
      </p>

      <div style="display:flex; gap:1rem; flex-wrap:wrap;">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link }}" class="btn btn-primary" style="background:#3b82f6; color:#ffffff;">
            {{ section.settings.btn1_label }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}

        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link }}" class="btn btn-secondary" style="border-color:#ffffff; color:#ffffff;">
            {{ section.settings.btn2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "New Season Arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Lifestyle With Precision Design"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover handcrafted essentials engineered for peak performance and effortless luxury. Designed to stand the test of time."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary Button Label",
      "default": "Explore Story"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
