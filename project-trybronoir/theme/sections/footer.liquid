<footer class="site-footer" data-src="sections/footer.liquid" style="background: #052d3f; color: #cbd5e1; padding: 70px 0 30px; border-top: 1px solid rgba(255, 255, 255, 0.1);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; margin-bottom: 50px;">
      <!-- Col 1 -->
      <div data-block="footer_col_1">
        <div style="font-size: 24px; font-weight: 900; letter-spacing: 0.1em; color: #ffffff; margin-bottom: 16px;">
          BRONOIR
        </div>
        <p style="font-size: 13px; line-height: 1.7; color: #94a3b8;">
          Pioneers in ergonomic barefoot footwear combined with pure copper grounding technology. Designed to relieve joint stress, restore posture, and reconnect you with nature.
        </p>
      </div>

      <!-- Col 2 -->
      <div data-block="footer_col_2">
        <h4 style="color: #ffffff; font-size: 15px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.05em;">Footwear Collections</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
          <li><a href="#bestsellers" style="color: #cbd5e1;">Copper Grounding Shoes</a></li>
          <li><a href="#bestsellers" style="color: #cbd5e1;">Winter Fleece Barefoot Boots</a></li>
          <li><a href="#bestsellers" style="color: #cbd5e1;">All-Terrain Trail Masters</a></li>
          <li><a href="#bestsellers" style="color: #cbd5e1;">Copper Infused Insoles</a></li>
        </ul>
      </div>

      <!-- Col 3 -->
      <div data-block="footer_col_3">
        <h4 style="color: #ffffff; font-size: 15px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.05em;">Customer Support</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
          <li><a href="#faq" style="color: #cbd5e1;">Track Your Order</a></li>
          <li><a href="#faq" style="color: #cbd5e1;">30-Day Money-Back Policy</a></li>
          <li><a href="#faq" style="color: #cbd5e1;">Shoe Sizing Guide</a></li>
          <li><a href="#faq" style="color: #cbd5e1;">Contact Us: support@trybronoir.com</a></li>
        </ul>
      </div>

      <!-- Col 4 -->
      <div data-block="footer_col_4">
        <h4 style="color: #ffffff; font-size: 15px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.05em;">Join The Barefoot Movement</h4>
        <p style="font-size: 13px; color: #94a3b8; margin-bottom: 12px;">Get exclusive VIP access to new releases, grounding tips, and secret flash sales.</p>
        <div style="display: flex; gap: 8px;">
          <input type="email" placeholder="Enter your email" style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: var(--radius-sm); padding: 10px 14px; color: #fff; font-size: 13px; flex-grow: 1; outline: none;">
          <button type="button" class="btn btn-primary" style="padding: 10px 18px; font-size: 13px;">SUBMIT</button>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Payment Badges -->
    <div style="border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 12px; color: #64748b;">
      <div>
        &copy; 2026 BRONOIR Canada. All rights reserved. Powered by Shopify OS 2.0.
      </div>
      <div style="display: flex; gap: 10px; font-size: 18px;">
        <span>💳 Visa</span>
        <span>💳 Mastercard</span>
        <span>💳 Amex</span>
        <span>💳 PayPal</span>
        <span>🔒 256-Bit SSL Encrypted</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
