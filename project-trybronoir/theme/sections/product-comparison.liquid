<section id="comparison" class="section comparison-section" data-src="sections/product-comparison.liquid" style="padding: 70px 0; background: var(--color-bg-subtle); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container" style="max-width: 920px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <div class="badge badge-accent" style="margin-bottom: 8px;">🔬 THE ERGONOMIC ADVANTAGE</div>
      <h2 class="section-title">Why Bronoir Barefoot Outperforms Normal Shoes</h2>
      <p class="section-subtitle">Traditional shoes squeeze your toes and disconnect you from the ground. Bronoir frees your feet.</p>
    </div>

    <div style="background: #ffffff; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--color-border);">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="background: #f1f5f9; border-bottom: 2px solid var(--color-border);">
            <th style="padding: 16px 20px; font-size: 14px; font-weight: 700; color: var(--color-text-main);">Features &amp; Health Impact</th>
            <th style="padding: 16px 20px; font-size: 15px; font-weight: 800; background: rgba(68, 194, 253, 0.15); color: var(--color-primary); border-left: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent);">
              🦶 Bronoir® Barefoot with Copper
            </th>
            <th style="padding: 16px 20px; font-size: 14px; font-weight: 600; color: #94a3b8;">Conventional Shoes</th>
          </tr>
        </thead>
        <tbody style="font-size: 14px;">
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: 16px 20px; font-weight: 600;">Toe Box Shape</td>
            <td style="padding: 16px 20px; background: rgba(68, 194, 253, 0.08); font-weight: 700; color: var(--color-primary); border-left: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent);">
              ✅ Wide anatomical shape (natural splay)
            </td>
            <td style="padding: 16px 20px; color: var(--color-text-muted);">❌ Narrow &amp; tapered (causes bunions &amp; pain)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: 16px 20px; font-weight: 600;">Heel-to-Toe Drop</td>
            <td style="padding: 16px 20px; background: rgba(68, 194, 253, 0.08); font-weight: 700; color: var(--color-primary); border-left: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent);">
              ✅ True Zero-Drop (restores spinal alignment)
            </td>
            <td style="padding: 16px 20px; color: var(--color-text-muted);">❌ Elevated heel (shortens Achilles tendon)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: 16px 20px; font-weight: 600;">Grounding / Earthing</td>
            <td style="padding: 16px 20px; background: rgba(68, 194, 253, 0.08); font-weight: 700; color: var(--color-primary); border-left: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent);">
              ✅ Real 100% Copper element sole contact
            </td>
            <td style="padding: 16px 20px; color: var(--color-text-muted);">❌ 100% Synthetic rubber insulation</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: 16px 20px; font-weight: 600;">Foot Muscle Activation</td>
            <td style="padding: 16px 20px; background: rgba(68, 194, 253, 0.08); font-weight: 700; color: var(--color-primary); border-left: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent);">
              ✅ Builds arch strength naturally
            </td>
            <td style="padding: 16px 20px; color: var(--color-text-muted);">❌ Weakens foot muscles over time</td>
          </tr>
          <tr>
            <td style="padding: 16px 20px; font-weight: 600;">Risk-Free Trial</td>
            <td style="padding: 16px 20px; background: rgba(68, 194, 253, 0.08); font-weight: 700; color: var(--color-primary); border-left: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent);">
              ✅ 30-Day Wear Guarantee + Buy 1, Get 2 Free!
            </td>
            <td style="padding: 16px 20px; color: var(--color-text-muted);">❌ Strict return policies on worn shoes</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Comparison",
  "settings": []
}
{% endschema %}
