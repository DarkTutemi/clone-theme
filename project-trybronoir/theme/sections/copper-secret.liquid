<section class="shopify-section video-with-text" data-src="sections/copper-secret.liquid" style="padding: 64px 0; background: rgba(64, 180, 235, 0.08);">
  <div class="container" style="max-width: 1360px; margin: 0 auto; padding: 0 24px;">
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;">
      
      <!-- Left Content -->
      <div>
        <span style="font-size: 14px; font-weight: 800; color: #44c2fd; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 10px;">
          GROUNDING EARTHING TECHNOLOGY
        </span>
        <h2 style="font-size: 38px; font-weight: 900; color: #032e43; line-height: 1.25; margin: 0 0 24px 0; letter-spacing: -0.02em;">
          The secret element that recharges your body and mind
        </h2>
        <p style="font-size: 16px; line-height: 1.7; color: #334155; margin: 0 0 24px 0;">
          Modern footwear insulates our bodies from the Earth's natural negative electric charge, accumulating stress, chronic inflammation, and fatigue.
        </p>

        <!-- Feature Points -->
        <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px;">
          <div style="display: flex; gap: 16px; align-items: flex-start; background: #ffffff; padding: 16px 20px; border-radius: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
            <div style="font-size: 24px; line-height: 1;">⚡</div>
            <div>
              <strong style="font-size: 16px; color: #08435e; display: block; margin-bottom: 4px;">100% Pure Copper Infused Sole</strong>
              <p style="font-size: 14px; color: #64748b; margin: 0; line-height: 1.5;">Direct grounding contact point allows free electron transfer into your body with every stride.</p>
            </div>
          </div>

          <div style="display: flex; gap: 16px; align-items: flex-start; background: #ffffff; padding: 16px 20px; border-radius: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
            <div style="font-size: 24px; line-height: 1;">🌿</div>
            <div>
              <strong style="font-size: 16px; color: #08435e; display: block; margin-bottom: 4px;">Reduces Swelling &amp; Pain</strong>
              <p style="font-size: 14px; color: #64748b; margin: 0; line-height: 1.5;">Relieves joint soreness, improves restorative sleep, and speeds up daily recovery.</p>
            </div>
          </div>
        </div>

        <a href="#bestsellers" style="display: inline-flex; align-items: center; justify-content: center; padding: 16px 36px; background: #08435e; color: #ffffff; font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border-radius: 9999px; text-decoration: none; box-shadow: 0 10px 25px rgba(8, 67, 94, 0.25); transition: background 0.2s ease;">
          GET 50% OFF TODAY! ➔
        </a>
      </div>

      <!-- Right Video / Visual Presentation -->
      <div style="position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,0.15); aspect-ratio: 16 / 10; background: #08435e;">
        <video style="width: 100%; height: 100%; object-fit: cover; display: block;" autoplay loop muted playsinline poster="https://trybronoir.com/cdn/shop/files/preview_images/faaab3359de74533a88c2363be50dce4.thumbnail.0000000000_600x.jpg?v=1762759930">
          <source src="https://trybronoir.com/cdn/shop/videos/c/vp/faaab3359de74533a88c2363be50dce4/faaab3359de74533a88c2363be50dce4.HD-1080p-7.2Mbps-62197190.mp4?v=0" type="video/mp4">
        </video>
        <div style="position: absolute; bottom: 20px; left: 20px; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); padding: 8px 16px; border-radius: 9999px; color: #ffffff; font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #44c2fd; display: inline-block;"></span>
          Copper Grounding Demonstration
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @media (max-width: 900px) {
    .video-with-text > div > div {
      grid-template-columns: 1fr !important;
      gap: 36px !important;
    }
  }
</style>

