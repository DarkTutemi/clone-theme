<div class="main-page-section" style="padding: 4rem 0;">
  <div class="page-width" style="max-width: 800px;">
    <h1 style="margin-bottom: 2rem;">{{ page.title }}</h1>
    <div style="line-height: 1.8; color: var(--color-text); font-size: 1.05rem;">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
