<section class="section section--flush hero-slideshow-section" data-src="sections/hero-banner.liquid" style="background: linear-gradient(116.53deg, rgba(8, 67, 94, 1) 12.4%, rgba(114, 195, 232, 1) 93.6%); position: relative; width: 100%; overflow: hidden;">
  <div class="slideshow__slide-inner" style="position: relative; width: 100%;">
    
    <!-- Desktop Banner Image (Exact replica of trybronoir.com) -->
    <div class="hero-banner-desktop" style="width: 100%; line-height: 0;">
      <a href="{{ section.settings.link | default: '#bestsellers' }}" data-block="hero_banner_desktop_link" style="display: block; width: 100%;">
        <img src="https://trybronoir.com/cdn/shop/files/bronoir_usp_banner.png?v=1790095247&width=2200"
             alt="Bronoir Grounding Barefoot Shoes — Prime Day Sale"
             style="width: 100%; height: auto; display: block; object-fit: cover;"
             loading="eager"
             fetchpriority="high"
             width="2200"
             height="943">
      </a>
    </div>

    <!-- Mobile Banner Image (Exact replica of trybronoir.com) -->
    <div class="hero-banner-mobile" style="width: 100%; line-height: 0; display: none;">
      <a href="{{ section.settings.link | default: '#bestsellers' }}" data-block="hero_banner_mobile_link" style="display: block; width: 100%;">
        <img src="https://trybronoir.com/cdn/shop/files/bronoir_usp_banner_movil.png?v=1790095315&width=1000"
             alt="Bronoir Grounding Barefoot Shoes — Prime Day Sale"
             style="width: 100%; height: auto; display: block; object-fit: cover;"
             loading="eager"
             fetchpriority="high"
             width="1000"
             height="1400">
      </a>
    </div>

    <!-- Floating Action Button (Exact 1:1 CTA Button) -->
    <div class="hero-cta-container" style="position: absolute; bottom: 35px; left: 0; right: 0; display: flex; justify-content: center; z-index: 10;" data-block="hero_cta_btn">
      <a href="{{ section.settings.link | default: '#bestsellers' }}"
         class="hero-claim-btn"
         style="display: inline-flex; align-items: center; justify-content: center; padding: 16px 48px; font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; background: #ffffff; color: #000000; border-radius: 9999px; text-decoration: none; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); transition: all 0.2s ease;">
        {{ section.settings.button_text | default: 'CLAIM OFFER' }}
      </a>
    </div>

  </div>
</section>

<style>
  @media (max-width: 768px) {
    .hero-banner-desktop { display: none !important; }
    .hero-banner-mobile { display: block !important; }
    .hero-cta-container { bottom: 22px !important; }
    .hero-claim-btn { padding: 14px 36px !important; font-size: 15px !important; }
  }
  @media (min-width: 769px) {
    .hero-banner-desktop { display: block !important; }
    .hero-banner-mobile { display: none !important; }
  }
  .hero-claim-btn:hover {
    background: #44c2fd !important;
    color: #000000 !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 35px rgba(68, 194, 253, 0.45) !important;
  }
</style>

{% schema %}
{
  "name": "Hero Slideshow Banner",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CLAIM OFFER"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    }
  ]
}
{% endschema %}
