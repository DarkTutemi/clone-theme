<section class="section faq-with-video" data-src="sections/bronoir-faq.liquid" style="padding: 64px 0; background: #ffffff;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- Testimonial Section Header -->
    <div style="text-align: center; margin-bottom: 40px;">
      <div style="display: flex; justify-content: center; margin-bottom: 12px;">
        <img src="https://trybronoir.com/cdn/shop/files/Bronoir_1200_x_300_px_4_310x.png?v=1761592105" alt="Bronoir" style="height: 32px;">
      </div>
      <h2 style="font-size: 36px; font-weight: 800; color: #08435e; margin: 0 0 10px 0;">
        They are talking about
      </h2>
      <p style="font-size: 16px; color: #64748b; margin: 0;">
        Real customer experiences walking barefoot with copper grounding every day.
      </p>
    </div>

    <!-- Video Review Cards Row -->
    <div class="video-reviews-row" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 56px;">
      
      <!-- Video 1 -->
      <div class="v-card" style="border-radius: 16px; overflow: hidden; position: relative; aspect-ratio: 9 / 14; background: #000; box-shadow: 0 8px 24px rgba(0,0,0,0.1);">
        <video style="width: 100%; height: 100%; object-fit: cover;" poster="https://trybronoir.com/cdn/shop/files/preview_images/4bc088b2d7604ac4a7f38fffb2badb3f.thumbnail.0000000000.jpg?v=1761677422&width=600" playsinline preload="metadata">
          <source src="https://trybronoir.com/cdn/shop/videos/c/vp/4bc088b2d7604ac4a7f38fffb2badb3f/4bc088b2d7604ac4a7f38fffb2badb3f.HD-1080p-7.2Mbps-61090627.mp4?v=0" type="video/mp4">
        </video>
        <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; color: #fff; z-index: 2;">
          <div style="color: #f59e0b; font-size: 14px; margin-bottom: 4px;">★★★★★</div>
          <p style="font-size: 13px; font-weight: 700; line-height: 1.4; margin: 0;">"Walking pain-free after 10 years of plantar fasciitis!"</p>
          <span style="font-size: 11px; opacity: 0.8;">— Sarah M. (Verified Buyer)</span>
        </div>
      </div>

      <!-- Video 2 -->
      <div class="v-card" style="border-radius: 16px; overflow: hidden; position: relative; aspect-ratio: 9 / 14; background: #000; box-shadow: 0 8px 24px rgba(0,0,0,0.1);">
        <video style="width: 100%; height: 100%; object-fit: cover;" poster="https://trybronoir.com/cdn/shop/files/preview_images/f2ba229a99da411fa5b9e0d626759d7e.thumbnail.0000000000.jpg?v=1762761596&width=600" playsinline preload="metadata">
          <source src="https://trybronoir.com/cdn/shop/videos/c/vp/f2ba229a99da411fa5b9e0d626759d7e/f2ba229a99da411fa5b9e0d626759d7e.HD-1080p-7.2Mbps-62198815.mp4?v=0" type="video/mp4">
        </video>
        <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; color: #fff; z-index: 2;">
          <div style="color: #f59e0b; font-size: 14px; margin-bottom: 4px;">★★★★★</div>
          <p style="font-size: 13px; font-weight: 700; line-height: 1.4; margin: 0;">"The wide toe box gives my feet room to breathe completely."</p>
          <span style="font-size: 11px; opacity: 0.8;">— Michael R. (Verified Buyer)</span>
        </div>
      </div>

      <!-- Video 3 -->
      <div class="v-card" style="border-radius: 16px; overflow: hidden; position: relative; aspect-ratio: 9 / 14; background: #000; box-shadow: 0 8px 24px rgba(0,0,0,0.1);">
        <video style="width: 100%; height: 100%; object-fit: cover;" poster="https://trybronoir.com/cdn/shop/files/preview_images/d5cb40357996446081fc4d34e22fae25.thumbnail.0000000000.jpg?v=1762760696&width=600" playsinline preload="metadata">
          <source src="https://trybronoir.com/cdn/shop/videos/c/vp/d5cb40357996446081fc4d34e22fae25/d5cb40357996446081fc4d34e22fae25.HD-1080p-7.2Mbps-62197875.mp4?v=0" type="video/mp4">
        </video>
        <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; color: #fff; z-index: 2;">
          <div style="color: #f59e0b; font-size: 14px; margin-bottom: 4px;">★★★★★</div>
          <p style="font-size: 13px; font-weight: 700; line-height: 1.4; margin: 0;">"Best shoes I've ever owned for winter hiking."</p>
          <span style="font-size: 11px; opacity: 0.8;">— Emma T. (Verified Buyer)</span>
        </div>
      </div>

    </div>

    <!-- FAQ Section -->
    <div style="max-width: 900px; margin: 0 auto;">
      <h3 style="font-size: 32px; font-weight: 800; color: #08435e; text-align: center; margin-bottom: 32px;">
        Frequently Asked Questions
      </h3>

      <div class="faq-accordion-list" style="display: flex; flex-direction: column; gap: 14px;">
        
        <!-- FAQ 1 -->
        <details class="faq-accordion-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 24px; cursor: pointer;">
          <summary style="font-size: 17px; font-weight: 700; color: #08435e; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>What makes BRONOIR shoes different from other barefoot shoes?</span>
            <span style="font-size: 20px; font-weight: 400; color: #44c2fd;">+</span>
          </summary>
          <div style="margin-top: 14px; font-size: 15px; line-height: 1.7; color: #475569;">
            BRONOIR combines barefoot ergonomics with grounding technology using real copper. This allows you to not only move naturally and improve posture but also reconnect with the Earth’s energy, helping reduce inflammation, stress, and fatigue. Plus, every pair is designed with premium materials for both comfort and style.
          </div>
        </details>

        <!-- FAQ 2 -->
        <details class="faq-accordion-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 24px; cursor: pointer;">
          <summary style="font-size: 17px; font-weight: 700; color: #08435e; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>How does the grounding (Earthing) function work?</span>
            <span style="font-size: 20px; font-weight: 400; color: #44c2fd;">+</span>
          </summary>
          <div style="margin-top: 14px; font-size: 15px; line-height: 1.7; color: #475569;">
            Each BRONOIR shoe features a copper plug built into the sole that maintains direct contact with the ground. Copper is a natural conductor, allowing electrons from the Earth to flow into the body. This helps neutralize free radicals and supports overall well-being, especially when walking on natural surfaces like grass, soil, or sand.
          </div>
        </details>

        <!-- FAQ 3 -->
        <details class="faq-accordion-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 24px; cursor: pointer;">
          <summary style="font-size: 17px; font-weight: 700; color: #08435e; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>Are BRONOIR shoes suitable for everyday wear?</span>
            <span style="font-size: 20px; font-weight: 400; color: #44c2fd;">+</span>
          </summary>
          <div style="margin-top: 14px; font-size: 15px; line-height: 1.7; color: #475569;">
            Absolutely! BRONOIR shoes are designed for daily use—whether you're walking, working, traveling, or simply relaxing. The minimalist sole offers a barefoot experience while providing just enough protection, and the stylish design means you can wear them almost anywhere.
          </div>
        </details>

        <!-- FAQ 4 -->
        <details class="faq-accordion-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 24px; cursor: pointer;">
          <summary style="font-size: 17px; font-weight: 700; color: #08435e; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>How should I choose the right size?</span>
            <span style="font-size: 20px; font-weight: 400; color: #44c2fd;">+</span>
          </summary>
          <div style="margin-top: 14px; font-size: 15px; line-height: 1.7; color: #475569;">
            We recommend selecting your regular size for a barefoot fit. If you're between sizes or prefer a slightly roomier feel, consider sizing up. Our sizing guide on the product page can help, and our customer service team is happy to advise based on your foot measurements.
          </div>
        </details>

        <!-- FAQ 5 -->
        <details class="faq-accordion-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 24px; cursor: pointer;">
          <summary style="font-size: 17px; font-weight: 700; color: #08435e; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>Can I wear BRONOIR shoes in wet conditions?</span>
            <span style="font-size: 20px; font-weight: 400; color: #44c2fd;">+</span>
          </summary>
          <div style="margin-top: 14px; font-size: 15px; line-height: 1.7; color: #475569;">
            While BRONOIR shoes are made with high-quality materials, we recommend avoiding heavy rain or very wet conditions to maintain the integrity of the grounding copper and the sole. A little moisture won’t hurt, but they’re best suited for dry, natural surfaces to get the full grounding benefit.
          </div>
        </details>

      </div>
    </div>

  </div>
</section>

<style>
  .faq-accordion-item[open] summary span:last-child {
    transform: rotate(45deg);
  }
  @media (max-width: 768px) {
    .video-reviews-row {
      grid-template-columns: 1fr !important;
      max-width: 380px;
      margin: 0 auto 40px auto !important;
    }
  }
</style>

