<section class="section shoes-icon-text" data-src="sections/shoes-icon-text.liquid" style="padding: 56px 0; background: #ffffff;">
  
  <!-- Running Marquee / Ticker -->
  <div class="benefits-marquee" style="overflow: hidden; white-space: nowrap; margin-bottom: 48px; border-top: 1px solid #f1f5f9; border-bottom: 1px solid #f1f5f9; padding: 14px 0;">
    <div class="marquee-track" style="display: inline-flex; animation: marquee-scroll 25s linear infinite; gap: 48px;">
      <span style="font-size: 28px; font-weight: 800; color: #44c2fd; letter-spacing: -0.02em; text-transform: capitalize;">• Podiatrist Recommended</span>
      <span style="font-size: 28px; font-weight: 800; color: #08435e; letter-spacing: -0.02em; text-transform: capitalize;">• Natural & Grounding</span>
      <span style="font-size: 28px; font-weight: 800; color: #44c2fd; letter-spacing: -0.02em; text-transform: capitalize;">• Wide Toe Box Anatomy</span>
      <span style="font-size: 28px; font-weight: 800; color: #08435e; letter-spacing: -0.02em; text-transform: capitalize;">• 100% Pure Copper Infusion</span>
      <span style="font-size: 28px; font-weight: 800; color: #44c2fd; letter-spacing: -0.02em; text-transform: capitalize;">• Podiatrist Recommended</span>
      <span style="font-size: 28px; font-weight: 800; color: #08435e; letter-spacing: -0.02em; text-transform: capitalize;">• Natural & Grounding</span>
    </div>
  </div>

  <div class="container" style="max-width: 1320px; margin: 0 auto; padding: 0 20px;">
    <div class="shoes-icon-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: center;">
      
      <!-- Feature 1: Zero Drop -->
      <div class="shoe-feature-item" style="display: flex; flex-direction: column; align-items: center;">
        <div class="shoe-feature-icon-wrap" style="height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px;">
          <img src="https://trybronoir.com/cdn/shop/files/icon1_300x.png?v=1761595176"
               alt="Zero Drop"
               style="max-width: 140px; max-height: 110px; object-fit: contain;"
               loading="lazy">
        </div>
        <h3 style="font-size: 19px; font-weight: 800; color: #282828; margin: 0 0 10px 0;">Zero Drop</h3>
        <p style="font-size: 14px; line-height: 1.6; color: #4b5563; margin: 0;">
          Our shoes have a completely flat sole – that means no heel elevation or artificial lift. This supports a natural posture and can help relieve long-term stress on your knees, hips, and back.
        </p>
      </div>

      <!-- Feature 2: Wide Toe Box -->
      <div class="shoe-feature-item" style="display: flex; flex-direction: column; align-items: center;">
        <div class="shoe-feature-icon-wrap" style="height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px;">
          <img src="https://trybronoir.com/cdn/shop/files/icon2_200x.png?v=1761595177"
               alt="Wide Toe Box"
               style="max-width: 110px; max-height: 110px; object-fit: contain;"
               loading="lazy">
        </div>
        <h3 style="font-size: 19px; font-weight: 800; color: #282828; margin: 0 0 10px 0;">Wide Toe Box</h3>
        <p style="font-size: 14px; line-height: 1.6; color: #4b5563; margin: 0;">
          Your toes need space – and that’s exactly what they get. Our wide toe box lets your feet expand naturally, without being cramped, for true comfort throughout the day.
        </p>
      </div>

      <!-- Feature 3: Ultra Thin Sole -->
      <div class="shoe-feature-item" style="display: flex; flex-direction: column; align-items: center;">
        <div class="shoe-feature-icon-wrap" style="height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px;">
          <img src="https://trybronoir.com/cdn/shop/files/icon3_200x.png?v=1761595179"
               alt="Ultra Thin Sole"
               style="max-width: 120px; max-height: 110px; object-fit: contain;"
               loading="lazy">
        </div>
        <h3 style="font-size: 19px; font-weight: 800; color: #282828; margin: 0 0 10px 0;">Ultra Thin Sole</h3>
        <p style="font-size: 14px; line-height: 1.6; color: #4b5563; margin: 0;">
          Less sole, more sensation: Feel the ground beneath your feet for a true barefoot experience, increased awareness while walking, and stronger foot muscles.
        </p>
      </div>

      <!-- Feature 4: Flexible Movement -->
      <div class="shoe-feature-item" style="display: flex; flex-direction: column; align-items: center;">
        <div class="shoe-feature-icon-wrap" style="height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px;">
          <img src="https://trybronoir.com/cdn/shop/files/icon4_260x.png?v=1761595180"
               alt="Flexible Movement"
               style="max-width: 130px; max-height: 110px; object-fit: contain;"
               loading="lazy">
        </div>
        <h3 style="font-size: 19px; font-weight: 800; color: #282828; margin: 0 0 10px 0;">Flexible Movement</h3>
        <p style="font-size: 14px; line-height: 1.6; color: #4b5563; margin: 0;">
          The highly flexible design of our shoes gives your feet complete freedom of movement. Your gait stays natural – healthy, light, and free.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (max-width: 900px) {
    .shoes-icon-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 24px !important;
    }
  }
  @media (max-width: 500px) {
    .shoes-icon-grid {
      grid-template-columns: 1fr !important;
      gap: 28px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Shoes Value Props",
  "settings": []
}
{% endschema %}
