<div class="shopify-section-videoreview-wrapper">
<style>
  .shopify-section-videoreview-wrapper {
    padding: 24px 0 44px;
    background: transparent;
  }
  .video-review-card-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .video-review-card-inner {
    background-color: #54c4f0;
    background-image: linear-gradient(135deg, #5ec6e8 0%, #54c4f0 100%);
    border-radius: 28px;
    padding: 42px 40px;
    box-shadow: 0 12px 36px rgba(84, 196, 240, 0.22);
  }
  @media (max-width: 768px) {
    .video-review-card-inner {
      padding: 32px 16px;
      border-radius: 20px;
    }
  }
  .video-review-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .video-review-header h2 {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.5px;
    line-height: 1.1;
  }
  @media (max-width: 768px) {
    .video-review-header h2 {
      font-size: 26px;
    }
  }
  .video-review-logo {
    display: inline-flex;
    align-items: center;
  }
  .video-review-logo img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }
  .video-review-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  @media (max-width: 1024px) {
    .video-review-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 640px) {
    .video-review-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
    }
    .video-review-grid .video-slide-item {
      flex: 0 0 78%;
      scroll-snap-align: center;
    }
  }
  .video-slide-item {
    background: #000;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    position: relative;
    border: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .video-slide-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  .video-wrapperrrr {
    position: relative;
    width: 100%;
    padding-top: 152%; /* 9:14 ratio matching original */
    cursor: pointer;
    background: #000;
    user-select: none;
  }
  .video-wrapperrrr video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
  }
  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 5;
    transition: transform 0.2s ease, opacity 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .video-wrapperrrr:hover .play-button {
    transform: translate(-50%, -50%) scale(1.1);
  }
  .sound-unmute-badge {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 9999px;
    display: none;
    align-items: center;
    gap: 6px;
    z-index: 6;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.2s;
  }
  .sound-unmute-badge:hover {
    background: rgba(0, 0, 0, 0.95);
  }
  .expand-modal-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    font-size: 14px;
    z-index: 6;
    opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .video-slide-item:hover .expand-modal-btn {
    opacity: 1;
  }
  .expand-modal-btn:hover {
    background: rgba(0, 0, 0, 0.85);
  }
  .video-review-cta {
    text-align: center;
    margin-top: 28px;
  }
  .video-review-cta a.see-all-reviews-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 38px;
    background: #ffffff;
    color: #032e43;
    border-radius: 9999px;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: all 0.25s ease;
  }
  .video-review-cta a.see-all-reviews-btn:hover {
    background: #f8fafc;
    color: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  /* Fullscreen Lightbox Modal */
  .video-review-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(12px);
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .video-review-modal.active {
    display: flex;
  }
  .video-modal-content {
    position: relative;
    max-width: 420px;
    width: 90%;
    aspect-ratio: 9/16;
    background: #000;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }
  .video-modal-content video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-modal-close {
    position: absolute;
    top: -46px;
    right: 0;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 32px;
    cursor: pointer;
    font-weight: 300;
    line-height: 1;
    padding: 4px;
  }
</style>

