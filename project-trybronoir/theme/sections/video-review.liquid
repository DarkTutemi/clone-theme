<!-- Lightbox Modal -->
<div id="video-review-modal" class="video-review-modal">
  <div class="video-modal-content">
    <button type="button" class="video-modal-close" aria-label="Đóng">&times;</button>
    <video id="modal-video-element" controls playsinline></video>
  </div>
</div>

<script>
  (function() {
    function initVideoReviews() {
      const allWrappers = document.querySelectorAll('.video-wrapperrrr');
      const modal = document.getElementById('video-review-modal');
      const modalVideo = document.getElementById('modal-video-element');
      const modalClose = document.querySelector('.video-modal-close');

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('active');
        if (modalVideo) {
          modalVideo.pause();
          modalVideo.removeAttribute('src');
          modalVideo.load();
        }
      }

      if (modalClose) {
        modalClose.addEventListener('click', closeModal);
      }
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeModal();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });

      // Expand buttons
      document.querySelectorAll('.expand-modal-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const card = btn.closest('.video-slide-item');
          const vid = card ? card.querySelector('video') : null;
          if (vid && modal && modalVideo) {
            // Pause all inlines
            allWrappers.forEach(function(w) {
              const v = w.querySelector('video');
              const b = w.querySelector('.play-button');
              if (v && !v.paused) {
                v.pause();
                v.controls = false;
                if (b) b.style.display = 'flex';
              }
            });

            modalVideo.src = vid.src || vid.querySelector('source')?.src;
            modal.classList.add('active');
            modalVideo.currentTime = vid.currentTime || 0;
            modalVideo.muted = false;
            modalVideo.play().catch(function() {
              modalVideo.muted = true;
              modalVideo.play();
            });
          }
        });
      });

      allWrappers.forEach(function(wrapper) {
        const vid = wrapper.querySelector('video');
        const playBtn = wrapper.querySelector('.play-button');
        const muteBadge = wrapper.querySelector('.sound-unmute-badge');
        if (!vid) return;

        // Ensure direct src attribute
        if (!vid.src) {
          const s = vid.querySelector('source');
          if (s && s.src) vid.src = s.src;
        }

        if (muteBadge) {
          muteBadge.addEventListener('click', function(e) {
            e.stopPropagation();
            vid.muted = false;
            muteBadge.style.display = 'none';
          });
        }

        wrapper.addEventListener('click', function(e) {
          // If clicked directly on native controls, ignore
          if (e.target === vid && vid.controls && !vid.paused) {
            return;
          }

          // Pause other videos
          allWrappers.forEach(function(otherWrapper) {
            const otherVid = otherWrapper.querySelector('video');
            const otherBtn = otherWrapper.querySelector('.play-button');
            const otherBadge = otherWrapper.querySelector('.sound-unmute-badge');
            if (otherVid && otherVid !== vid) {
              otherVid.pause();
              otherVid.controls = false;
              if (otherBtn) otherBtn.style.display = 'flex';
              if (otherBadge) otherBadge.style.display = 'none';
            }
          });

          if (vid.paused) {
            // Try unmuted first
            const playPromise = vid.play();
            if (playPromise !== undefined) {
              playPromise.then(function() {
                vid.controls = true;
                if (playBtn) playBtn.style.display = 'none';
                if (muteBadge) muteBadge.style.display = 'none';
              }).catch(function(err) {
                // If audio restricted by browser policy, play muted and show Unmute button
                console.log('Audio autoplay restricted, falling back to muted:', err);
                vid.muted = true;
                vid.play().then(function() {
                  vid.controls = true;
                  if (playBtn) playBtn.style.display = 'none';
                  if (muteBadge) muteBadge.style.display = 'flex';
                }).catch(function(e2) {
                  console.error('Video playback failed:', e2);
                });
              });
            }
          } else {
            vid.pause();
            vid.controls = false;
            if (playBtn) playBtn.style.display = 'flex';
            if (muteBadge) muteBadge.style.display = 'none';
          }
        });

        vid.addEventListener('ended', function() {
          vid.pause();
          vid.currentTime = 0;
          vid.controls = false;
          if (playBtn) playBtn.style.display = 'flex';
          if (muteBadge) muteBadge.style.display = 'none';
        });

        vid.addEventListener('pause', function() {
          if (vid.currentTime > 0 && !vid.seeking) {
            if (playBtn) playBtn.style.display = 'flex';
          }
        });

        vid.addEventListener('play', function() {
          if (playBtn) playBtn.style.display = 'none';
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoReviews);
    } else {
      initVideoReviews();
    }
  })();
</script>
</div>

