<div class="image-with-text-section" style="padding: 5rem 0; background-color: var(--color-surface);">
  <div class="page-width">
    <div class="grid grid-cols-2" style="align-items: center; gap: 4rem;">
      <div class="image-with-text__media" style="border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
        {%- else -%}
          <div style="width: 100%; height: 450px; background: linear-gradient(135deg, #1e293b, #0f172a); display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 1.1rem; font-weight: 500;">
            Crafted for Perfection
          </div>
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        <p style="font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--color-accent); margin-bottom:0.75rem;">
          {{ section.settings.badge }}
        </p>
        <h2 style="margin-bottom: 1.5rem;">{{ section.settings.heading }}</h2>
        <div style="font-size: 1.05rem; color: var(--color-text-muted); line-height: 1.7; margin-bottom: 2rem;">
          {{ section.settings.text }}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn-primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Pre-heading",
      "default": "Sustainable Quality"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to stand apart from the ordinary"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every component is engineered with meticulous attention to detail. We blend high-grade materials with modern ergonomics to deliver lasting durability and unmatched tactile elegance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
