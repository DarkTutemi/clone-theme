<section class="comparison-section" data-src="sections/product-comparison.liquid" style="background: #ffffff; padding: 4.5rem 0;">
  <div class="page-width">
    <div style="text-align: center; max-width: 650px; margin: 0 auto;">
      <span class="badge badge-brand" style="margin-bottom: 0.5rem;">Why Azure Stands Apart</span>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 0.25rem;">
        Ours Heals From Within.
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-top: 0.5rem;">
        Cheap oils leave your hair suffocated under silicone and mineral film. Pure Batana penetrates the follicle root.
      </p>
    </div>

    <div class="comparison-grid">
      <!-- Authentic Azure -->
      <div class="comparison-card brand-card">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.5rem;">🌿</span>
          <h3 style="font-size: 1.4rem; color: var(--color-primary);">Azure Pure Batana</h3>
        </div>
        <div style="font-size: 0.85rem; color: var(--color-primary); font-weight: 600; margin-top: 0.25rem;">
          Single Ingredient • Cold Pressed
        </div>

        <ul class="comparison-list">
          <li class="comparison-item check">
            <span><strong>100% Wild-Harvested Batana:</strong> Directly sourced from indigenous Honduran communities.</span>
          </li>
          <li class="comparison-item check">
            <span><strong>Rich In Oleic & Linoleic Acids:</strong> Penetrates the hair shaft to rebuild cortex structure.</span>
          </li>
          <li class="comparison-item check">
            <span><strong>Zero Mineral Fillers:</strong> Non-comedogenic formula that never suffocates your scalp.</span>
          </li>
          <li class="comparison-item check">
            <span><strong>Natural Roasted Scent:</strong> Authentic smoky coffee aroma proving zero chemical bleaching.</span>
          </li>
          <li class="comparison-item check">
            <span><strong>30-Day Money-Back Guarantee:</strong> 100% risk-free trial for every customer.</span>
          </li>
        </ul>
      </div>

      <!-- Generic / Diluted Competitors -->
      <div class="comparison-card competitor-card">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.5rem;">❌</span>
          <h3 style="font-size: 1.4rem; color: var(--color-text-muted);">Generic Market Hair Oils</h3>
        </div>
        <div style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600; margin-top: 0.25rem;">
          Mass-Manufactured • Diluted
        </div>

        <ul class="comparison-list">
          <li class="comparison-item cross">
            <span><strong>80%+ Cheap Mineral / Canola Fillers:</strong> Only a tiny fraction of active batana extract.</span>
          </li>
          <li class="comparison-item cross">
            <span><strong>Heavy Synthetic Fragrance:</strong> Chemically perfumed to mask industrial solvent odor.</span>
          </li>
          <li class="comparison-item cross">
            <span><strong>Silicone Film Coating:</strong> Masks dryness with temporary slip while dehydrating inner cortex.</span>
          </li>
          <li class="comparison-item cross">
            <span><strong>Clogs Scalp Follicles:</strong> Buildup chokes roots and accelerates edge breakage.</span>
          </li>
          <li class="comparison-item cross">
            <span><strong>No Satisfaction Guarantee:</strong> All sales final without testing proof.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Comparison",
  "settings": [],
  "presets": [
    {
      "name": "Product Comparison"
    }
  ]
}
{% endschema %}
