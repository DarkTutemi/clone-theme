<section class="faq-section" data-src="sections/product-faq.liquid">
  <div class="page-width">
    <div style="text-align: center; max-width: 650px; margin: 0 auto;">
      <span class="badge badge-brand" style="margin-bottom: 0.5rem;">Got Questions?</span>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 0.25rem;">
        Frequently Asked Questions
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-top: 0.5rem;">
        Everything you need to know about using authentic Honduran Batana Oil.
      </p>
    </div>

    <div class="faq-accordion">
      <!-- Q1 -->
      <div class="faq-item">
        <button class="faq-question" onclick="this.parentElement.classList.toggle('is-open')">
          <span>What does authentic Batana Oil smell like?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          Raw, authentic Honduran Batana Oil has a rich, earthy, roasted coffee aroma. This distinct scent is natural proof that the oil is unrefined and extracted without chemical deodorizers or harsh industrial bleaching.
        </div>
      </div>

      <!-- Q2 -->
      <div class="faq-item">
        <button class="faq-question" onclick="this.parentElement.classList.toggle('is-open')">
          <span>How quickly will I see visible results?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          Most customers notice softer hair and less scalp itchiness within 1 to 2 weeks. Noticeable reduction in hair shedding and baby hair growth around the edges typically begins between weeks 3 and 6 of consistent use (3-4 times per week).
        </div>
      </div>

      <!-- Q3 -->
      <div class="faq-item">
        <button class="faq-question" onclick="this.parentElement.classList.toggle('is-open')">
          <span>How do I apply Batana Oil for maximum effectiveness?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          Warm a dime-to-quarter sized amount in the palms of your hands until it melts into a smooth oil. Massage thoroughly into your scalp and thinning areas for 3-5 minutes. Leave on for at least 30 minutes, or overnight with a satin bonnet, then wash out with gentle shampoo.
        </div>
      </div>

      <!-- Q4 -->
      <div class="faq-item">
        <button class="faq-question" onclick="this.parentElement.classList.toggle('is-open')">
          <span>Is this safe for color-treated and all hair textures?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          Yes! Our Batana Oil is 100% pure single-ingredient oil, completely free from sulfates, parabens, silicones, and artificial dyes. It is suitable for all hair textures (1A to 4C) and color-treated hair.
        </div>
      </div>

      <!-- Q5 -->
      <div class="faq-item">
        <button class="faq-question" onclick="this.parentElement.classList.toggle('is-open')">
          <span>How does the 30-Day Money-Back Guarantee work?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          We stand behind the potency of our Batana oil. If you don't love the improvement in your hair's softness and health after 30 days of use, simply email our customer support team for a full refund without hassle.
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product FAQ",
  "settings": [],
  "presets": [
    {
      "name": "Product FAQ"
    }
  ]
}
{% endschema %}
