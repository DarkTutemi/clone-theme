<section class="ingredients-section" data-src="sections/product-ingredients.liquid" style="background: var(--color-surface); padding: 4.5rem 0;">
  <div class="page-width">
    <div style="text-align: center; max-width: 650px; margin: 0 auto 3rem;">
      <span class="badge badge-brand" style="margin-bottom: 0.5rem;">The Gold Standard</span>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 0.25rem;">
        100% Single Ingredient. Unmatched Potency.
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-top: 0.5rem;">
        No fillers. No emulsifiers. No synthetic stabilizers. Just cold-pressed Elaeis Oleifera seed oil packed with bioactive nutrients.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
      <!-- Card 1 -->
      <div style="background: #ffffff; padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">💧</div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Vitamin E Complex</h3>
        <p style="font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.6;">
          Powerful antioxidant shield that neutralizes free radical damage on the scalp and prevents premature follicle weakening.
        </p>
      </div>

      <!-- Card 2 -->
      <div style="background: #ffffff; padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">🧬</div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Omega 3-6-9 Fatty Acids</h3>
        <p style="font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.6;">
          Deep lipid replenishment that seals moisture into dry cuticles and restores tensile strength against hair snapping.
        </p>
      </div>

      <!-- Card 3 -->
      <div style="background: #ffffff; padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">🌿</div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Vitamin A Complex</h3>
        <p style="font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.6;">
          Accelerates cellular regeneration in scalp dermal papillae to speed up the transition into active growth (Anagen) phase.
        </p>
      </div>

      <!-- Card 4 -->
      <div style="background: #ffffff; padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">🛡️</div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Natural Phytosterols</h3>
        <p style="font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.6;">
          Soothes chronic inflammation and rebalances scalp sebum production without producing greasy residual buildup.
        </p>
      </div>
    </div>
  </div>
</section>

