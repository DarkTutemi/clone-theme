<section class="social-proof-bar" data-src="sections/social-proof-bar.liquid">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <span class="badge badge-brand" style="margin-bottom: 0.5rem;">Verified Community Results</span>
      <h2 style="font-size: clamp(1.4rem, 2.5vw, 2rem); margin-top: 0.25rem;">
        What can 3-8 weeks of use do for your edges?
      </h2>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number">200k+</div>
        <div class="stat-label">Happy Customers Worldwide</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">850,000+</div>
        <div class="stat-label">Bottles Crafted & Shipped</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">58k+</div>
        <div class="stat-label">5-Star Verified Reviews</div>
      </div>
    </div>
  </div>
</section>

