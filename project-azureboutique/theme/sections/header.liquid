<header 
  class="site-header" 
  data-src="sections/header.liquid"
  style="background-color: #ffffff; border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: 100; transition: box-shadow var(--transition-fast);"
>
  <div class="page-width" style="display: flex; align-items: center; justify-content: space-between; height: 70px;">
    <!-- Mobile Hamburger Toggle -->
    <div class="header__mobile-toggle" style="display: none;">
      <button class="mobile-menu-btn" aria-label="Open Navigation Menu" style="font-size: 1.5rem; color: var(--color-text);">
        ☰
      </button>
    </div>

    <!-- Logo / Brand Identity -->
    <div class="header__logo">
      <a href="{{ routes.root_url }}" style="font-size: 1.6rem; font-weight: 700; color: var(--color-primary); letter-spacing: -0.02em; display: inline-flex; align-items: center; gap: 0.5rem;">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 140 }}" alt="{{ shop.name }}" style="max-height: 40px; width: auto;">
        {%- else -%}
          <span>{{ shop.name | default: "Azure" }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Menu -->
    <nav class="header__nav" style="display: flex; gap: 2rem; align-items: center;">
      <a href="{{ routes.all_products_collection_url }}" class="nav-link" style="font-weight: 500; font-size: 0.95rem;">Shop All</a>
      <a href="/collections/batana" class="nav-link" style="font-weight: 500; font-size: 0.95rem;">Batana Hair Oil</a>
      <a href="/pages/hair-routine-quiz" class="nav-link" style="font-weight: 500; font-size: 0.95rem;">Hair Quiz</a>
      <a href="/pages/our-story" class="nav-link" style="font-weight: 500; font-size: 0.95rem;">Our Story</a>
      <a href="/pages/faq" class="nav-link" style="font-weight: 500; font-size: 0.95rem;">FAQ</a>
    </nav>

    <!-- Header Actions (Search & Cart) -->
    <div class="header__actions" style="display: flex; align-items: center; gap: 1.25rem;">
      <a href="{{ routes.search_url }}" aria-label="Search" style="color: var(--color-text); font-size: 1.2rem;">
        🔍
      </a>
      
      <button class="cart-trigger-btn" aria-label="Open Cart" style="display: flex; align-items: center; gap: 0.4rem; color: var(--color-text); position: relative;">
        <span style="font-size: 1.3rem;">🛍️</span>
        <span class="cart-count-badge" style="background: var(--color-primary); color: #fff; font-size: 0.75rem; font-weight: 700; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  @media screen and (max-width: 749px) {
    .header__mobile-toggle { display: block !important; }
    .header__nav { display: none !important; }
  }
  .nav-link:hover {
    color: var(--color-primary);
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
