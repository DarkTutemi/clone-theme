<footer 
  class="site-footer" 
  data-src="sections/footer.liquid"
  style="background: #111813; color: #fdfbf7; padding: 4.5rem 0 2rem; border-top: 1px solid rgba(255,255,255,0.1);"
>
  <div class="page-width">
    <!-- Top 4 Columns -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem;">
      <!-- Col 1: Brand Info -->
      <div>
        <h3 style="color: #ffffff; font-size: 1.4rem; margin-bottom: 1rem;">
          {{ shop.name | default: "Azure Boutique" }}
        </h3>
        <p style="color: rgba(253,251,247,0.7); font-size: 0.9rem; line-height: 1.7;">
          Rooted in indigenous Honduran hair rituals. We craft 100% pure, wild-harvested Batana oil formulas designed to restore thinning edges, nourish scalp health, and spark natural fullness.
        </p>
        <div style="display: flex; gap: 1rem; margin-top: 1.25rem; font-size: 1.25rem;">
          <a href="#" style="color: rgba(253,251,247,0.8);">Instagram</a>
          <a href="#" style="color: rgba(253,251,247,0.8);">TikTok</a>
          <a href="#" style="color: rgba(253,251,247,0.8);">Facebook</a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 style="color: #ffffff; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">
          Explore
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.9rem; color: rgba(253,251,247,0.75);">
          <li><a href="/collections/batana" style="hover: color: #fff;">Batana Growth Oil</a></li>
          <li><a href="/collections/bundle-collection" style="hover: color: #fff;">Restoration Bundles</a></li>
          <li><a href="/pages/hair-routine-quiz" style="hover: color: #fff;">Take Hair Quiz</a></li>
          <li><a href="/pages/our-story" style="hover: color: #fff;">Our Honduran Story</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div>
        <h4 style="color: #ffffff; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">
          Customer Care
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.9rem; color: rgba(253,251,247,0.75);">
          <li><a href="/pages/faq">Frequently Asked Questions</a></li>
          <li><a href="/pages/contact">Contact Support</a></li>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms-service">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div>
        <h4 style="color: #ffffff; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">
          Join The Inner Circle
        </h4>
        <p style="color: rgba(253,251,247,0.7); font-size: 0.85rem; margin-bottom: 1rem;">
          Subscribe for secret sales, edge-recovery routines, and 15% off your first bottle.
        </p>
        <form style="display: flex; gap: 0.5rem;">
          <input 
            type="email" 
            placeholder="Enter your email" 
            style="flex-grow: 1; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); color: #fff; font-size: 0.85rem;"
          >
          <button type="button" class="btn btn-primary" style="padding: 0.75rem 1.25rem; font-size: 0.85rem;">
            Join
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Line -->
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.8rem; color: rgba(253,251,247,0.5);">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "Azure Boutique" }}. All Rights Reserved. Clean-Room OS 2.0 Rebuild.
      </div>
      <div style="display: flex; gap: 0.75rem; font-size: 1.1rem;">
        <span>💳 Visa</span>
        <span>💳 Mastercard</span>
        <span>💳 Amex</span>
        <span>💳 Shop Pay</span>
        <span>💳 Apple Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
