<section class="routine-quiz-banner" data-src="sections/routine-quiz-banner.liquid" style="padding: 4.5rem 0; background: var(--color-soft-bg);">
  <div class="page-width">
    <div style="background: #ffffff; border-radius: var(--radius-xl); padding: clamp(2rem, 5vw, 4rem); border: 1px solid var(--color-border); box-shadow: var(--shadow-card); display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center;">
      <div>
        <span class="badge badge-brand" style="margin-bottom: 0.75rem;">1-Minute Personalized Assessment</span>
        <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); color: var(--color-text); margin-top: 0.25rem; text-transform: uppercase;">
          {{ section.settings.title | default: "TAKE OUR HAIR QUIZ" }}
        </h2>
        <p style="color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.6; margin: 1rem 0 2rem;">
          {{ section.settings.text | default: "Not sure which Batana formula is right for your hair porosity and edges? Answer 4 quick questions and get your tailored restoration routine." }}
        </p>
        <a href="{{ section.settings.link | default: '/pages/hair-routine-quiz' }}" class="btn btn-primary" style="padding: 1.1rem 2.5rem; font-size: 1.05rem;">
          {{ section.settings.button_label | default: "Start Quiz Now →" }}
        </a>
      </div>

      <div style="background: var(--color-surface); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); aspect-ratio: 4/3; box-shadow: var(--shadow-sm);">
        <img src="https://www.azureboutique.co/cdn/shop/files/A_1.png?v=1744104079&width=800" alt="Hair Quiz Routine" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
    </div>
  </div>
</section>

<style>
  @media screen and (max-width: 749px) {
    .routine-quiz-banner .page-width > div {
      grid-template-columns: 1fr !important;
      gap: 1.5rem !important;
      padding: 1.5rem !important;
    }
  }
</style>

{% schema %}
{
  "name": "Routine Quiz Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TAKE OUR HAIR QUIZ"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Not sure which Batana formula is right for your hair porosity and edges? Answer 4 quick questions and get your tailored restoration routine."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Start Quiz Now →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Quiz Page Link"
    }
  ],
  "presets": [
    {
      "name": "Routine Quiz Banner"
    }
  ]
}
{% endschema %}
