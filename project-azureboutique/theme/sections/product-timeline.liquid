<section class="timeline-section" data-src="sections/product-timeline.liquid">
  <div class="page-width">
    <div style="text-align: center; max-width: 650px; margin: 0 auto;">
      <span class="badge badge-brand" style="margin-bottom: 0.5rem;">Clinical Journey</span>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 0.25rem;">
        Results To Expect Over Time
      </h2>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-top: 0.5rem;">
        Consistency is the secret to natural hair awakening. Here is what our customers experience week by week:
      </p>
    </div>

    <div class="timeline-grid">
      <!-- Card 1 -->
      <div class="timeline-card">
        <div class="timeline-card__period">Weeks 1 — 2</div>
        <div class="timeline-card__title">Scalp Awakening & Deep Hydration</div>
        <p class="timeline-card__desc">
          Dry flakes and itchiness disappear. Your scalp feels nourished and refreshed. Hair strands absorb natural fatty acids and gain noticeable softness and elastic shine.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="timeline-card">
        <div class="timeline-card__period">Weeks 3 — 4</div>
        <div class="timeline-card__title">Shedding Halts & Roots Strengthen</div>
        <p class="timeline-card__desc">
          Significant reduction in hair loss during wash days and combing. Follicles anchor deeper into the scalp tissue as micro-circulation around the edges increases.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="timeline-card">
        <div class="timeline-card__period">Weeks 6 — 8</div>
        <div class="timeline-card__title">Visible Growth & Restored Fullness</div>
        <p class="timeline-card__desc">
          Fine baby hairs sprout along thinning edges, temples, and crown areas. The overall hair density feels thicker, stronger, and more resilient to styling tension.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Timeline",
  "settings": [],
  "presets": [
    {
      "name": "Product Timeline"
    }
  ]
}
{% endschema %}
