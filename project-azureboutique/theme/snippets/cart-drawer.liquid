<div id="CartDrawerOverlay" class="cart-drawer-overlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"></div>

<div 
  id="CartDrawer" 
  class="cart-drawer" 
  data-src="snippets/cart-drawer.liquid"
  role="dialog" 
  aria-modal="true" 
  aria-label="Shopping Cart"
  style="position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 100vw); background: #ffffff; z-index: 999; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; box-shadow: var(--shadow-drawer);"
>
  <!-- Header -->
  <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between;">
    <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text); margin: 0;">Your Cart</h3>
    <button type="button" data-cart-drawer-close aria-label="Close cart" style="font-size: 1.25rem; cursor: pointer; padding: 0.25rem 0.5rem; color: var(--color-text);">
      ✕
    </button>
  </div>

  <!-- Free Shipping Progress Bar -->
  <div style="padding: 0.9rem 1.5rem; background: var(--color-soft-bg); border-bottom: 1px solid var(--color-border); font-size: 0.85rem; font-weight: 600; color: var(--color-primary); text-align: center;">
    {%- assign free_shipping_threshold = 5000 -%}
    {%- if cart.total_price >= free_shipping_threshold -%}
      <span>🎉 You unlocked FREE Shipping!</span>
    {%- else -%}
      {%- assign remaining = free_shipping_threshold | minus: cart.total_price -%}
      <span>Add {{ remaining | money }} more for <strong>FREE Shipping</strong></span>
    {%- endif -%}
    <div style="width: 100%; height: 6px; background: rgba(68,98,74,0.15); border-radius: 3px; margin-top: 0.4rem; overflow: hidden;">
      <div style="height: 100%; background: var(--color-primary); width: {% if cart.total_price >= free_shipping_threshold %}100%{% else %}{{ cart.total_price | times: 100 | divided_by: free_shipping_threshold }}%{% endif %}; transition: width 0.3s ease;"></div>
    </div>
  </div>

  <!-- Cart Items List -->
  <div id="CartDrawerItems" style="flex-grow: 1; overflow-y: auto; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
    {%- if cart.item_count == 0 -%}
      <div style="text-align: center; padding: 3rem 1rem; color: var(--color-text-muted);">
        <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🛍️</div>
        <p style="font-size: 1.1rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">Your cart is empty</p>
        <p style="font-size: 0.9rem; margin-bottom: 1.5rem;">Discover our pure Batana formulations and start your restoration journey.</p>
        <button type="button" data-cart-drawer-close class="btn btn-primary">
          Explore Products
        </button>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-drawer-item" data-line-key="{{ item.key }}" style="display:flex; gap:1rem; align-items:center; border-bottom:1px solid var(--color-border-subtle); padding-bottom:1rem;">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title }}" width="70" height="70" style="object-fit:cover; border-radius:var(--radius-sm); border: 1px solid var(--color-border);">
          {%- endif -%}
          <div style="flex-grow:1;">
            <h4 style="font-size:0.95rem; font-weight:600;"><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
            {%- unless item.product.has_only_default_variant -%}
              <p style="font-size:0.8rem; color:var(--color-text-muted);">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.5rem;">
              <span style="font-size:0.95rem; font-weight:700; color: var(--color-primary);">{{ item.final_line_price | money }}</span>
              <span style="font-size:0.85rem; color:var(--color-text-muted);">Qty: {{ item.quantity }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- Footer -->
  <div style="padding: 1.25rem 1.5rem; border-top: 1px solid var(--color-border); background: #ffffff;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
      <span style="font-size:1.05rem; font-weight:600;">Subtotal</span>
      <span id="CartDrawerSubtotal" style="font-size:1.3rem; font-weight:700; color: var(--color-primary);">{{ cart.total_price | money }}</span>
    </div>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn-primary" style="width: 100%; padding: 1.1rem; font-size: 1.05rem; font-weight: 700;">
        Proceed to Checkout →
      </button>
    </form>
    <div style="text-align: center; margin-top: 0.75rem; font-size: 0.75rem; color: var(--color-text-muted);">
      🔒 Secure 256-Bit SSL Encrypted Checkout
    </div>
  </div>
</div>

<script>
  // Open / Close Drawer Event Listeners
  document.addEventListener('DOMContentLoaded', () => {
    const drawer = document.getElementById('CartDrawer');
    const overlay = document.getElementById('CartDrawerOverlay');
    
    function openCart() {
      if (drawer && overlay) {
        drawer.style.transform = 'translateX(0)';
        overlay.style.opacity = '1';
        overlay.style.pointerEvents = 'auto';
      }
    }
    function closeCart() {
      if (drawer && overlay) {
        drawer.style.transform = 'translateX(100%)';
        overlay.style.opacity = '0';
        overlay.style.pointerEvents = 'none';
      }
    }

    document.querySelectorAll('.cart-trigger-btn').forEach(btn => btn.addEventListener('click', openCart));
    document.querySelectorAll('[data-cart-drawer-close]').forEach(btn => btn.addEventListener('click', closeCart));
    if (overlay) overlay.addEventListener('click', closeCart);
  });
</script>
