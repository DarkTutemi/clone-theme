    {
      "id": 9827666100533,
      "title": "Batana Growth Conditioner",
      "handle": "batana-natural-hair-growth-conditioner",
      "body_html": "<div class=\"flex max-w-full flex-col flex-grow\">\n<div data-message-model-slug=\"gpt-4o\" class=\"min-h-8 text-message flex w-full flex-col items-end gap-2 whitespace-normal break-words [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-id=\"3bcc7a23-afde-47fc-b536-3050e4bfc517\" data-message-author-role=\"assistant\">\n<div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\">\n<div class=\"markdown prose w-full break-words dark:prose-invert light\">\n<ul>\n<li>\n<strong>Deeply Hydrating Formula</strong>: Azure Batana Conditioner infuses hair with lasting moisture, restoring softness and shine.</li>\n<li>\n<strong>Batana Oil Powered</strong>: Enriched with the nourishing properties of pure Batana oil to strengthen and revitalize hair.</li>\n<li>\n<strong>Smoothing &amp; Detangling</strong>: Leaves hair silky, manageable, and easy to style.</li>\n<li>\n<strong>Perfect for All Hair Types</strong>: Ideal for dry, damaged, and curly hair, promoting natural resilience and health.</li>\n<li>\n<strong>Chemical-Free</strong>: Free from sulfates, parabens, and synthetic additives for a gentle, natural conditioning experience.<span data-state=\"closed\" class=\"\"><button class=\"cursor-pointer h-[30px] rounded-md px-1 text-token-text-secondary hover:bg-token-main-surface-secondary\" data-state=\"closed\" aria-expanded=\"false\" aria-haspopup=\"menu\" id=\"radix-:r6mi:\" type=\"button\"></button></span>\n</li>\n</ul>\n</div>\n</div>\n</div>\n</div>",
