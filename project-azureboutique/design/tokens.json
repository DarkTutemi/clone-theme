{
  "name": "Azure Boutique Design Tokens",
  "version": "1.0.0",
  "clean_room": true,
  "colors": {
    "primary_accent": {
      "hex": "#44624a",
      "rgb": "68, 98, 74",
      "hsl": "131, 18%, 34%",
      "usage": "Primary CTA buttons, active states, key brand accents, guarantee badges"
    },
    "primary_accent_hover": {
      "hex": "#38523d",
      "rgb": "56, 82, 61",
      "hsl": "132, 19%, 27%",
      "usage": "Button hover state"
    },
    "background_base_1": {
      "hex": "#ffffff",
      "rgb": "255, 255, 255",
      "hsl": "0, 0%, 100%",
      "usage": "Main page canvas, cards, modal popups"
    },
    "background_base_2": {
      "hex": "#f3f3f3",
      "rgb": "243, 243, 243",
      "hsl": "0, 0%, 95%",
      "usage": "Section backgrounds, subtle contrast blocks"
    },
    "background_soft_tint": {
      "hex": "#e9ece9",
      "rgb": "233, 236, 233",
      "hsl": "120, 7%, 92%",
      "usage": "Bundle selection cards, highlight pill boxes, quote containers"
    },
    "text_primary": {
      "hex": "#121212",
      "rgb": "18, 18, 18",
      "hsl": "0, 0%, 7%",
      "usage": "Headings, body text, primary icons"
    },
    "text_secondary": {
      "hex": "#555555",
      "rgb": "85, 85, 85",
      "hsl": "0, 0%, 33%",
      "usage": "Subtitles, meta info, prices compare-at, reviews count"
    },
    "button_solid_label": {
      "hex": "#fdfbf7",
      "rgb": "253, 251, 247",
      "hsl": "40, 43%, 98%",
      "usage": "Text on primary accent buttons (clean off-white cream)"
    },
    "border_default": {
      "hex": "#44624a33",
      "rgba": "rgba(68, 98, 74, 0.2)",
      "usage": "Subtle borders around cards, bundle options, pickers"
    },
    "sale_badge": {
      "hex": "#dd1d1d",
      "rgb": "221, 29, 29",
      "hsl": "0, 77%, 49%",
      "usage": "Urgency banner, discount percentage badges, sale tags"
    }
  },
  "typography": {
    "font_family_base": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font_family_heading": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap",
    "font_weights": {
      "regular": 400,
      "medium": 500,
      "semi_bold": 600,
      "bold": 700
    },
    "scale": {
      "body_base": "1.5rem",
      "body_desktop": "1.6rem",
      "heading_h1": "3.8rem",
      "heading_h2": "2.8rem",
      "heading_h3": "2.0rem",
      "caption": "1.3rem",
      "badge": "1.1rem"
    },
    "letter_spacing": "0.06em",
    "line_height": "1.5"
  },
  "radius": {
    "button": "6px",
    "product_card": "12px",
    "media": "12px",
    "badge": "6px",
    "container_card": "24px",
    "variant_pill": "40px",
    "drawer": "22px",
    "input": "6px"
  },
  "shadows": {
    "card": "0 4px 15px rgba(0, 0, 0, 0.05)",
    "card_hover": "0 8px 25px rgba(68, 98, 74, 0.12)",
    "drawer": "-5px 0 25px rgba(0, 0, 0, 0.15)",
    "button_hover": "0 4px 12px rgba(68, 98, 74, 0.3)"
  },
  "layout": {
    "page_width": "1400px",
    "gutter_desktop": "40px",
    "gutter_mobile": "20px",
    "header_height": "70px"
  },
  "breakpoints": {
    "mobile": "749px",
    "tablet_min": "750px",
    "tablet_max": "989px",
    "desktop": "990px",
    "wide": "1200px"
  }
}
